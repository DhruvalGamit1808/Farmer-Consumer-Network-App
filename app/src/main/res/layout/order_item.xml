<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <!-- Vegetable Image -->
        <ImageView
            android:id="@+id/orderImage"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="10dp"
            android:scaleType="centerCrop"
            android:src="@drawable/tomato"
            android:background="@drawable/rounded_bg"
            android:clipToOutline="true" />

        <!-- Order Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/orderProductName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tomato"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/orderPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹50"
                android:textSize="14sp"
                android:textColor="@android:color/darker_gray" />

            <TextView
                android:id="@+id/orderQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Qty: 2"
                android:textSize="14sp"
                android:textColor="@android:color/darker_gray" />

            <TextView
                android:id="@+id/orderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:textSize="14sp"
                android:textStyle="italic"
                android:textColor="@android:color/holo_orange_dark" />

            <TextView
                android:id="@+id/orderUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="5dp"
                android:text="User: " />

            <TextView
                android:id="@+id/orderUserMobile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="5dp"
                android:text="Mobile: " />

            <TextView
                android:id="@+id/orderUserAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Address: N/A"
                android:textSize="14sp"
                android:paddingTop="10dp" />

            <TextView
            android:id="@+id/orderDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
                android:paddingTop="5dp"
            android:text="Date: 01-01-2025"
            android:textSize="10sp"
            android:textColor="#000000"/>

            <TextView
                android:id="@+id/orderTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time: 12:30 PM"
                android:textSize="10sp"
                android:textColor="#000000"/>


        </LinearLayout>

        <!-- Buttons vertical layout -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/startDeliveryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start Delivery"
                android:backgroundTint="#2196F3"
                android:textColor="@android:color/white"/>

            <Button
                android:id="@+id/markDeliveredButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delivered"
                android:backgroundTint="#4CAF50"
                android:textColor="@android:color/white"/>

            <Button
                android:id="@+id/cancelButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textColor="@android:color/white"
                android:backgroundTint="@android:color/holo_red_dark"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
