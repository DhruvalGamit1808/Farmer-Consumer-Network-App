<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="6dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- IMAGE -->
        <ImageView
            android:id="@+id/vegImage"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:scaleType="centerCrop"
            android:background="@drawable/rounded_bg"
            android:clipToOutline="true" />

        <!-- MAIN CONTENT -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="5dp">

            <!-- NAME -->
            <TextView
                android:id="@+id/vegName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vegetable Name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- PRICE -->
            <TextView
                android:id="@+id/vegPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textSize="16sp"
                android:textColor="#2E7D32"
                android:textStyle="bold"
                android:paddingTop="2dp"/>

            <!-- STOCK -->
            <TextView
                android:id="@+id/vegQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available: 0"
                android:textSize="13sp"
                android:textColor="#757575"
                android:paddingTop="2dp"/>

            <!-- DETAILS TOGGLE -->

            <!-- EXPANDABLE DETAILS (FIXED WIDTH) -->
            <TextView
                android:id="@+id/tvDetailsToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="View Seller Details ▼"
                android:textColor="#1976D2"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/detailsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="6dp"
                android:background="@color/nav_bg"
                android:padding="6dp">

                <TextView
                    android:id="@+id/vegUserName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="👨‍🌾 Farmer: —"
                    android:textSize="13sp"
                    android:textColor="#444" />

                <TextView
                    android:id="@+id/vegUserMobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📞 Mobile: —"
                    android:textSize="13sp"
                    android:textColor="#444"
                    android:paddingTop="2dp"/>

                <TextView
                    android:id="@+id/vegUserAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📍 Address: —"
                    android:textSize="12sp"
                    android:textColor="#666"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:paddingTop="2dp"/>
            </LinearLayout>

            <!-- QUANTITY SELECTOR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp">

                <Button
                    android:id="@+id/decreaseQty"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="1dp"
                    android:text="−"
                    android:textSize="18sp"/>

                <TextView
                    android:id="@+id/selectedQty"
                    android:layout_width="45dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="1"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/increaseQty"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="+"
                    android:padding="1dp"
                    android:textSize="15sp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ACTION BUTTONS -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <Button
                android:id="@+id/buyButton"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:text="BUY"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:backgroundTint="#2E7D32"/>

            <Button
                android:id="@+id/deleteButton"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:text="DELETE"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:backgroundTint="#D32F2F"
                android:visibility="gone"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>